# 火山引擎 Ark API Key（必填）
ARK_API_KEY=your-ark-api-key-here

# Ark API 基础地址
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 模型
SEEDREAM_MODEL=doubao-seedream-4-5-251128
SEEDANCE_MODEL=doubao-seedance-1-5-pro-251215

# 产物输出目录 / 持久化数据目录
GENERATED_DIR=./generated
DATA_DIR=./data

# ffmpeg 路径（需支持 hevc_videotoolbox，macOS 为 /opt/homebrew/bin/ffmpeg）
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# 每日免费设备名额
FREE_DAILY_LIMIT=5
